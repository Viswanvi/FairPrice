# Copy to .env and fill in. Never commit .env (Prisma CLI and the tsx scripts read .env).

# PayPal sandbox (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# App URLs (used for PayPal return/cancel URLs)
APP_BASE_URL=http://localhost:3000

# AI for audience analysis and pricing
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Database (local: docker compose up -d db)
DATABASE_URL=postgresql://fairprice:fairprice@localhost:5432/fairprice

# Seller sign-in for the demo
SESSION_SECRET=
SELLER_DEMO_PASSWORD=

# Demo only: allow ?as=IN to simulate the visitor's IP country for the DISPLAYED price
DEMO_GEO_OVERRIDE=true
